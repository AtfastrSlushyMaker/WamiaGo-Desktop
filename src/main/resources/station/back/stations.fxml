<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.station.back.StationsController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <!-- Header with title -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <ImageView fitHeight="32.0" fitWidth="32.0">
                     <image>
                        <Image url="@/images/station/icons/bike_station.png" />
                     </image>
                  </ImageView>
                  <Label styleClass="title-label" text="Bike Station Management" />
               </children>
            </HBox>

            <!-- Search and buttons -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <TextField fx:id="searchField" promptText="Search stations..." prefWidth="300.0" styleClass="search-field" />
                  <HBox spacing="10.0" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                     <children>
                        <Button fx:id="exportToPdfButton" mnemonicParsing="false" styleClass="export-button" text="Export to PDF">
                           <graphic>
                              <ImageView fitHeight="16.0" fitWidth="16.0">
                                 <image>
                                    <Image url="@/images/station/icons/pdf_export.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Button fx:id="refreshButton" mnemonicParsing="false" styleClass="refresh-button">
                           <graphic>
                              <ImageView fitHeight="16.0" fitWidth="16.0">
                                 <image>
                                    <Image url="@/images/station/icons/refresh_icon.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Button fx:id="addButton" mnemonicParsing="false" styleClass="primary-button" text="Add Station">
                           <graphic>
                              <ImageView fitHeight="16.0" fitWidth="16.0">
                                 <image>
                                    <Image url="@/images/station/icons/add.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <Button fx:id="deleteButton" mnemonicParsing="false" styleClass="delete-button" text="Delete Selected">
                           <graphic>
                              <ImageView fitHeight="16.0" fitWidth="16.0">
                                 <image>
                                    <Image url="@/images/station/icons/delete.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- Table view with stations -->
            <TableView fx:id="stationTableView" VBox.vgrow="ALWAYS" styleClass="station-table">
               <!-- Columns are created dynamically in controller -->
            </TableView>

            <!-- Status bar -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <ProgressIndicator fx:id="loadingIndicator" visible="false" />
                  <Label fx:id="statusLabel" text="Ready" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>