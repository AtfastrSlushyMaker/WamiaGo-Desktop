<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.user.UsersController"
            style="-fx-background-color: #f0f0f0;"
            prefHeight="400.0" prefWidth="600.0">

    <VBox alignment="CENTER" spacing="20.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">

        <Label text="User Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <Label text="Total Users: 3" style="-fx-font-size: 18px;"/>

        <VBox spacing="10.0">
            <Label text="1. John Doe - john@example.com"/>
            <Label text="2. Jane Smith - jane@example.com"/>
            <Label text="3. Bob Johnson - bob@example.com"/>
        </VBox>

    </VBox>

</AnchorPane>