<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.chart.PieChart?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.taxi.adminside.StatisticsRequestRide"
            prefHeight="400.0" prefWidth="800.0">

    <!-- HBox to arrange ride statistics and request statistics horizontally -->
    <HBox spacing="20.0" layoutX="20.0" layoutY="20.0">

        <!-- VBox for Ride Statistics -->
        <VBox spacing="10" alignment="TOP_LEFT">
            <Text fx:id="totalRidesText" text="Total Rides: 0" />
            <Text fx:id="completedRidesText" text="Completed Rides: 0" />
            <Text fx:id="ongoingRidesText" text="Ongoing Rides: 0" />
            <Text fx:id="canceledRidesText" text="Canceled Rides: 0" />
        </VBox>

        <!-- PieChart for Ride Status -->
        <PieChart fx:id="rideStatusPieChart" prefWidth="150.0" prefHeight="150.0" />

        <!-- BarChart for Ride Status Distribution -->
        <BarChart fx:id="rideStatusBarChart" prefWidth="150.0" prefHeight="150.0">
            <xAxis>
                <CategoryAxis label="Ride Status"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Number of Rides"/>
            </yAxis>
        </BarChart>

    </HBox>

    <!-- HBox for Request Statistics -->
    <HBox spacing="20.0" layoutX="20.0" layoutY="250.0">

        <!-- VBox for Request Statistics -->
        <VBox spacing="10" alignment="TOP_LEFT">
            <Text fx:id="totalRequestsText" text="Total Requests: 0" />
            <Text fx:id="pendingRequestsText" text="Pending Requests: 0" />
            <Text fx:id="acceptedRequestsText" text="Accepted Requests: 0" />
            <Text fx:id="canceledRequestsText" text="Canceled Requests: 0" />
        </VBox>

        <!-- PieChart for Request Status -->
        <PieChart fx:id="requestStatusPieChart" prefWidth="150.0" prefHeight="150.0" />

        <!-- BarChart for Request Status Distribution -->
        <BarChart fx:id="requestStatusBarChart" prefWidth="150.0" prefHeight="150.0">
            <xAxis>
                <CategoryAxis label="Request Status"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Number of Requests"/>
            </yAxis>
        </BarChart>

    </HBox>
</AnchorPane>
