<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.wamiago.wamiago.utils.MainViewController">

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10.0" style="-fx-background-color: #2D3447;">
            <padding>
                <Insets top="20.0" right="10.0" bottom="20.0" left="10.0"/>
            </padding>

            <!-- Logo or App Name -->
            <Label text="Taxi Management" style="-fx-text-fill: white; -fx-font-size: 20px;">
                <VBox.margin>
                    <Insets bottom="20.0"/>
                </VBox.margin>
            </Label>

            <!-- Menu Buttons -->
            <Button fx:id="dashboardBtn" text="Dashboard" styleClass="menu-button" maxWidth="Infinity" />
            <Button fx:id="requestsBtn" text="Requests" styleClass="menu-button" maxWidth="Infinity" />
            <Button fx:id="ridesBtn" text="Rides" styleClass="menu-button" maxWidth="Infinity" />
            <Button fx:id="driversBtn" text="Drivers" styleClass="menu-button" maxWidth="Infinity" />
            <Button fx:id="settingsBtn" text="Settings" styleClass="menu-button" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox>
            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 10;">
                <Label fx:id="pageTitle" text="Dashboard" style="-fx-font-size: 24px;">
                    <HBox.margin>
                        <Insets right="20.0"/>
                    </HBox.margin>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <TextField promptText="Search..." />
                <Button text="Profile" styleClass="profile-button">
                    <HBox.margin>
                        <Insets left="10.0"/>
                    </HBox.margin>
                </Button>
            </HBox>

            <!-- Main Content -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="20.0" style="-fx-background-color: #f4f4f4;">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                    </padding>

                    <!-- Statistics Cards -->
                    <HBox spacing="20.0">
                        <VBox styleClass="stat-card" style="-fx-background-color: white; -fx-padding: 20;">
                            <Label text="Total Requests" style="-fx-text-fill: #666;"/>
                            <Label fx:id="requestsCount" text="150" style="-fx-font-size: 24px;"/>
                        </VBox>
                        <VBox styleClass="stat-card" style="-fx-background-color: white; -fx-padding: 20;">
                            <Label text="Active Rides" style="-fx-text-fill: #666;"/>
                            <Label fx:id="ridesCount" text="45" style="-fx-font-size: 24px;"/>
                        </VBox>
                        <VBox styleClass="stat-card" style="-fx-background-color: white; -fx-padding: 20;">
                            <Label text="Available Drivers" style="-fx-text-fill: #666;"/>
                            <Label fx:id="driversCount" text="28" style="-fx-font-size: 24px;"/>
                        </VBox>
                    </HBox>

                    <!-- Recent Activities Table -->
                    <TableView fx:id="recentActivitiesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="timeColumn" text="Time" />
                            <TableColumn fx:id="activityColumn" text="Activity" />
                            <TableColumn fx:id="statusColumn" text="Status" />
                        </columns>
                    </TableView>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>