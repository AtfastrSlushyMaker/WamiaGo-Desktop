<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import java.net.URL?>
<VBox fx:id="root" spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AddAnnouncementController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>


    <Label text="Ajouter une Annonce" styleClass="title-label" />

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Titre :" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Contenu :" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <TextArea fx:id="contentField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Zone :" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <ComboBox fx:id="zoneComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <Label text="Statut :" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <CheckBox fx:id="statusCheckBox" text="Actif" GridPane.rowIndex="3" GridPane.columnIndex="1" />
    </GridPane>

    <Button fx:id="submitButton" text="Soumettre" onAction="#handleSubmitButtonAction" styleClass="submit-button" />
</VBox>