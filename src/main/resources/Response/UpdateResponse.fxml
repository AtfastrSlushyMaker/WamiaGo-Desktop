<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Response.UpdateResponse">
    <VBox spacing="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="home_button" mnemonicParsing="false" text="Home" />
            <Label styleClass="title-label" text="Update Response">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>
        </HBox>

        <VBox spacing="10.0" styleClass="reclamation-details">
            <Label styleClass="section-label" text="Reclamation Details:">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label styleClass="field-label" text="Title:">
            <font>
               <Font name="System Bold Italic" size="12.0" />
            </font></Label>
            <Label fx:id="reclamationTitleLabel" styleClass="content-label" wrapText="true" />
            <Label styleClass="field-label" text="Content:">
            <font>
               <Font name="System Bold Italic" size="12.0" />
            </font></Label>
            <Label fx:id="reclamationContentLabel" styleClass="content-label" wrapText="true" />
        </VBox>

        <VBox spacing="10.0">
            <Label styleClass="section-label" text="Update Your Response:">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <TextArea fx:id="responseContentArea" prefHeight="150.0" promptText="Enter your updated response here..." style="-fx-background-color: black; -fx-border-radius: 8px; -fx-background-radius: 8px;" wrapText="true" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="cancelButton" mnemonicParsing="false" style="-fx-background-color: red;" text="Cancel" />
            <Button fx:id="updateButton" defaultButton="true" mnemonicParsing="false" style="-fx-background-color: green;" text="Update" />
        </HBox>
    </VBox>
</AnchorPane>
