<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" styleClass="background" stylesheets="@style.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.rentals.back.rentalController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-container">
               <children>
                  <Label styleClass="page-title" text="Rental Management">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <ComboBox fx:id="filter_status" prefWidth="150.0" promptText="Filter Status" />
                        <TextField fx:id="search_field" prefHeight="35.0" prefWidth="200.0" promptText="Search rentals..." styleClass="search-field" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </HBox>

            <ScrollPane fx:id="rentals_scroll_pane" fitToWidth="true" styleClass="rentals-scroll-pane" VBox.vgrow="ALWAYS">
               <content>
                  <FlowPane fx:id="rentals_container" hgap="15.0" prefWidth="860.0" styleClass="rentals-flow-pane" vgap="15.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </FlowPane>
               </content>
            </ScrollPane>

            <HBox alignment="CENTER" spacing="30.0" styleClass="action-buttons-container">
               <children>
                  <Button fx:id="add_button" mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0" styleClass="action-button,add-button" text="Add Rental">
                     <graphic>
                        <Label styleClass="button-icon,add-icon" />
                     </graphic>
                  </Button>
                  <Button fx:id="delete_button" mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0" styleClass="action-button,delete-button" text="Delete">
                     <graphic>
                        <Label styleClass="button-icon,delete-icon" />
                     </graphic>
                  </Button>
                  <Button fx:id="refresh_button" mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0" styleClass="action-button,refresh-button" text="Refresh">
                     <graphic>
                        <Label styleClass="button-icon,refresh-icon" />
                     </graphic>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
