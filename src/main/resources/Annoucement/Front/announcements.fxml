                        </graphic>
                    </Button>
                    <Button fx:id="btnAddRelocation" onAction="#btnAddRelocation" style="-fx-background-color: transparent;">
                        <graphic>
                            <VBox alignment="CENTER">
                                <ImageView fitHeight="45.0" fitWidth="45.0">
                                    <image>
                                        <Image url="@../../images/icons/relocation.png" />
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #2d3436;" text="See Relocations" />
                            </VBox>
                        </graphic>
                    </Button>
                    <Button fx:id="btnAdd" onAction="#handleAddButton" style="-fx-background-color: transparent;">
                        <graphic>
                            <VBox alignment="CENTER">
                                <ImageView fitHeight="35.0" fitWidth="35.0">
                                    <image>
                                        <Image url="@../../images/icons/add_anoncement.png" />
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #2d3436;" text="Add Announcement" />
                            </VBox>
                        </graphic>
                    </Button>
                </HBox>

                <!-- GridPane for announcements -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="483.0" prefViewportHeight="597.0" prefViewportWidth="1000" prefWidth="1012.0" vbarPolicy="AS_NEEDED">
