                                <Font name="Century Gothic Bold" size="13.0" />
                            </font>
                        </Button>

                        <Button id="logout-button" fx:id="btn_workbench1211" layoutX="73.0" layoutY="711.0" prefHeight="56.0" prefWidth="160.0" styleClass="navbar_buttons" stylesheets="@styles.css" text="Logout" textFill="#c6b6b6" onAction="#handleLogoutButtonAction">
                            <font>
                                <Font name="Century Gothic Bold" size="13.0" />
                            </font>
                        </Button>
                        <ImageView fitHeight="36.0" fitWidth="44.0" layoutX="83.0" layoutY="721.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../images/icons/logout.png" />
                            </image></ImageView>
                        <Pane fx:id="pane_1121" layoutX="19.0" layoutY="47.0" prefHeight="140.0" prefWidth="248.0" styleClass="logo-pane" stylesheets="@styles.css">
                            <children>
                                <ImageView id="logo" fitHeight="118.0" fitWidth="176.0" layoutX="40.0" layoutY="11.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../images/logo/wamiaGO.png" />
                                    </image>
                                </ImageView>
                            </children>
                        </Pane>
                        <ImageView id="home" fitHeight="36.0" fitWidth="44.0" layoutX="47.0" layoutY="267.0" pickOnBounds="true" preserveRatio="true" styleClass="home">
                            <image>
                                <Image url="@../../images/icons/home.png" />
                            </image>
                        </ImageView>
                        <ImageView fitHeight="49.0" fitWidth="50.0" layoutX="48.0" layoutY="363.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../images/icons/rides.png" />
                            </image></ImageView>
                        <ImageView fitHeight="36.0" fitWidth="36.0" layoutX="47.0" layoutY="480.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../images/icons/delivery-truck.png" />
                            </image>
                        </ImageView>

                    </children>

                </AnchorPane>

            </children>

        </VBox>


        <Pane fx:id="mainPane" prefHeight="827.0" prefWidth="1143.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
            <!-- Upper navigation bar -->
            <ButtonBar id="upper_nav" layoutY="-7.0" prefHeight="96.0" prefWidth="1093.0" />

            <!-- Main container -->
            <VBox alignment="CENTER" layoutX="50.0" layoutY="100.0" spacing="20">
                <!-- Search Section -->
                <!-- Search Section -->
                <HBox alignment="CENTER" spacing="20">
                    <!-- Keyword Search -->
                    <TextField fx:id="keywordTextField" prefWidth="200" promptText="Search by keyword..." />

                    <!-- Date Picker -->
                    <DatePicker fx:id="datePicker" promptText="Select date..." />

                    <!-- Zone ComboBox -->
                    <ComboBox fx:id="zoneComboBox" prefHeight="43.0" prefWidth="159.0" promptText="Select zone..." />
                </HBox>

                <!-- Announcements section with icon -->
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="32" fitWidth="32">
                        <image>
                            <Image url="@../../images/icons/annonce.png" />
                        </image>
                    </ImageView>
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" text="View and manage your posted announcements easily in one place." />
                </HBox>

                <!-- Action Buttons Container -->
                <HBox alignment="CENTER" spacing="20">
                    <Button fx:id="btnAddReservation" onAction="#btnAddReservation" style="-fx-background-color: F5F7FB;">
